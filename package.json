{
  "name": "socraticode",
  "mcpName": "io.github.giancarloerra/socraticode",
  "version": "1.16.1",
  "description": "SocratiCode — MCP server for local codebase indexing, semantic search, and code dependency graphs. All private, all local via Docker.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "socraticode": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "check:release-versions": "node scripts/check-release-versions.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "release": "release-it",
    "prepublishOnly": "tsc && node scripts/copy-assets.mjs",
    "release:dry": "release-it --dry-run",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "socraticode",
    "codebase",
    "indexer",
    "vector-database",
    "qdrant",
    "ollama",
    "embeddings",
    "code-graph"
  ],
  "author": {
    "name": "Giancarlo Erra",
    "email": "giancarlo@altaire.com",
    "url": "https://altaire.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giancarloerra/socraticode.git"
  },
  "bugs": {
    "url": "https://github.com/giancarloerra/socraticode/issues"
  },
  "homepage": "https://socraticode.cloud",
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    "agents",
    "hooks",
    ".mcp.json",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "README.md",
    "THIRD-PARTY-LICENSES",
    "socraticode_logo_thumbnail.png"
  ],
  "dependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-dart": "^0.0.7",
    "@ast-grep/lang-elixir": "^0.0.7",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-lua": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-scala": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.51.1",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "~1.19.18",
    "@lumis-sh/wasm-eex": "^0.26.3",
    "@lumis-sh/wasm-heex": "^0.26.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@parcel/watcher": "^2.6.0",
    "@qdrant/js-client-rest": "~1.18.0",
    "glob": "^10.5.0",
    "ignore": "^7.0.14",
    "ollama": "0.6.3",
    "open": "^10.2.0",
    "openai": "^6.49.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3",
    "undici": "^6.29.1",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "tree-sitter-gdscript": "6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.12",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.7"
    },
    "postcss": "8.5.32",
    "release-it": {
      "undici": "7.30.1"
    },
    "get-uri": {
      "basic-ftp": "6.2.5"
    }
  }
}
